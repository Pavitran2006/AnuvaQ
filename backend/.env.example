# AetherQ Studio Backend Environment Variables

# Security
SECRET_KEY=aetherq_prod_secret_key_change_me_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Environment Mode: 'development' or 'production'
ENVIRONMENT=production

# Database URL (SQLite for local dev, PostgreSQL for cloud production)
# SQLite: sqlite:///./aetherq.db
# PostgreSQL: postgresql://user:password@hostname:5432/aetherq_db
DATABASE_URL=sqlite:///./aetherq.db

# CORS Configuration (Comma-separated list of allowed origins)
# Example: https://aetherq.vercel.app,https://aetherq-frontend.onrender.com,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,https://*.vercel.app,https://*.onrender.com

# Port & Server Configuration
PORT=8000
HOST=0.0.0.0
